{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Playwright: Run All Tests (Docker)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/utilities/playwright/run-tests.ps1",
                "-ProjectRoot", "${input:projectRoot}",
                "-BaseUrl", "${input:baseUrl}"
            ],
            "group": "test",
            "presentation": { "reveal": "always", "panel": "new", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Playwright: Run Filtered Tests (Docker)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/utilities/playwright/run-tests.ps1",
                "-ProjectRoot", "${input:projectRoot}",
                "-BaseUrl", "${input:baseUrl}",
                "-Filter", "${input:testFilter}"
            ],
            "group": "test",
            "presentation": { "reveal": "always", "panel": "new", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "NUnit: Tests in Current File",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/utilities/nunit/Invoke-NUnitTests.ps1",
                "-Mode", "CurrentFile",
                "-FilePath", "${file}"
            ],
            "group": "test",
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "NUnit: Tests in Repository",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/utilities/nunit/Invoke-NUnitTests.ps1",
                "-Mode", "Repository",
                "-FilePath", "${file}"
            ],
            "group": "test",
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "projectRoot",
            "description": "Absolute path to the project root containing Playwright tests",
            "type": "promptString",
            "default": "C:/Code/my-project"
        },
        {
            "id": "baseUrl",
            "description": "Base URL of the running application",
            "type": "promptString",
            "default": "http://localhost:5000"
        },
        {
            "id": "testFilter",
            "description": "Test name grep pattern (leave empty for all tests)",
            "type": "promptString",
            "default": ""
        }
    ]
}
