{
    "_comment": "Paste the 'tasks' array entries into your project's .vscode/tasks.json. Requires developer-tools to be included as a workspace folder named 'developer-tools'. Tests run inside a .NET SDK container — Docker Desktop must be running. The SDK version is auto-detected from global.json or TargetFramework.",
    "tasks": [
        {
            "label": "NUnit: Tests in Current File",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder:developer-tools}/utilities/nunit/Invoke-NUnitTests.ps1",
                "-Mode", "CurrentFile",
                "-FilePath", "${file}"
            ],
            "group": "test",
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "NUnit: Tests in Repository",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder:developer-tools}/utilities/nunit/Invoke-NUnitTests.ps1",
                "-Mode", "Repository",
                "-FilePath", "${file}"
            ],
            "group": "test",
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
            "problemMatcher": []
        }
    ]
}
